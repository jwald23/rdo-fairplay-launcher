<Window x:Class="CommunityFrontier.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1000" Height="760" MinWidth="920" MinHeight="720" Icon="Assets/rdo-fairplay-logo-clean.png" Background="#131313" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="156"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
    <Grid ClipToBounds="True">
      <Image Source="Assets/frontier-banner.png" Stretch="UniformToFill" VerticalAlignment="Center"/>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CC131313" Offset="0"/><GradientStop Color="#35131313" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Grid Margin="30,12"><Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="Assets/rdo-fairplay-logo-clean.png" Width="132" Height="132" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" AutomationProperties.Name="RDO FairPlay logo"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="RDO FairPlay" FontFamily="Bahnschrift Condensed" FontSize="36" FontWeight="Bold"/><TextBlock Text="A better place to ride." Foreground="#D5C9B9" FontSize="14" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="2" Content="Settings &amp; help" Command="{Binding ToggleSettingsCommand}" VerticalAlignment="Top" Margin="0" Background="#B3191919" Padding="14,9"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" Margin="30,24,30,20">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#1C1C1C" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="22">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="YOUR ACCOUNT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Margin="0,16,0,16">
            <TextBlock Text="{Binding RockstarStatus}" Foreground="{Binding RockstarColor}" FontWeight="SemiBold" FontSize="20" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding AccountSummary}" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" Margin="0,10,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DiscordIcon}" Foreground="{Binding DiscordColor}" Width="24"/><TextBlock Text="{Binding DiscordStatus}" FontSize="12"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding ServerIcon}" Foreground="{Binding ServerColor}" Width="24"/><TextBlock Text="{Binding ServerStatus}" FontSize="12"/></StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="3">
            <Button Content="Open Discord · Verify" Command="{Binding JoinDiscordCommand}" Margin="0,0,0,8" Padding="12,11" Background="#292522"/>
            <UniformGrid Columns="2"><Button Content="{Binding DiscordButtonLabel}" Command="{Binding DiscordCommand}" FontSize="11" Margin="0,0,4,0" Padding="7,9"/><Button Content="Refresh status" Command="{Binding RefreshAccountCommand}" FontSize="11" Margin="4,0,0,0" Padding="7,9"/></UniformGrid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR GAME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding GameStatus}" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Find game" Command="{Binding BrowseCommand}" Margin="12,0,0,0" Padding="12,8"/></Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
          <TextBlock Text="HOW DO YOU WANT TO PLAY?" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <RadioButton GroupName="Mode" IsChecked="{Binding FairPlaySelected}" IsEnabled="{Binding FairPlayAvailable}" AutomationProperties.Name="Fair Play — requires verification" Margin="0,0,0,10">
            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Fair Play" FontSize="19" FontWeight="SemiBold"/><Border Background="#332A25" CornerRadius="4" Padding="7,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding FairPlayBadge}" Foreground="#D4B288" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="Private lobbies for Verified members." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Mode" IsChecked="{Binding OriginalSettingsSelected}" AutomationProperties.Name="Original Settings — no verification needed">
            <StackPanel><TextBlock Text="Original Settings" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Play Red Dead Online with your original setup." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Waiting for verification? You can still play online using Original Settings." Foreground="#B8B0A4" FontSize="12" LineHeight="18" Margin="0,14,0,0"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#191919" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" Padding="30,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" MaxHeight="36" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
        <Button Grid.Column="1" Command="{Binding PlayCommand}" Content="{Binding PlayLabel}" Background="{StaticResource Red}" BorderBrush="{StaticResource Red}" FontSize="16" FontWeight="SemiBold" Padding="18,16" Margin="0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.RowSpan="2" Background="#191919" Margin="30,16,30,20" CornerRadius="10" Padding="22" Panel.ZIndex="2">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Settings &amp; help" FontSize="22" FontWeight="SemiBold"/><Button Content="Back to play" Command="{Binding ToggleSettingsCommand}" HorizontalAlignment="Right" Margin="0"/></Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="{Binding InstallationPrompt}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" IsEnabled="{Binding IsIdle}" MinHeight="32" AutomationProperties.Name="Game installation"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource Ink}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <WrapPanel Margin="0,14,0,0"><Button Content="Search my computer" Command="{Binding SearchCommand}"/><Button Content="Cancel search" Command="{Binding CancelCommand}"/></WrapPanel><TextBlock Text="Where do you play Red Dead?" Margin="0,15,0,8"/>
            <WrapPanel><Button Content="Open Steam" Command="{Binding OpenSteamCommand}"/><Button Content="Open Epic Games" Command="{Binding OpenEpicCommand}"/><Button Content="Rockstar / I’m not sure" Command="{Binding HelpCommand}"/></WrapPanel>
            <TextBlock Text="Select RDR2.exe, its folder, a Steam library, or a parent Games folder. After opening your store, retry detection." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            <WrapPanel><Button Content="Find Red Dead again" Command="{Binding DetectCommand}"/><Button Content="Choose RDR2.exe" Command="{Binding BrowseExeCommand}"/><Button Content="Check everything" Command="{Binding DiagnoseCommand}"/><Button Content="Open game folder" Command="{Binding OpenFolderCommand}"/><Button Content="Copy diagnostic report" Command="{Binding CopyCommand}"/></WrapPanel>
            <WrapPanel><Button Content="Restore original settings" Command="{Binding RestoreCommand}"/><Button Content="Emergency restore" Command="{Binding EmergencyCommand}"/><Button Content="Prepare for uninstall" Command="{Binding UninstallCommand}"/></WrapPanel>
            <Expander Header="Advanced diagnostics" Foreground="{StaticResource Muted}" Margin="0,10,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding Diagnostics}" FontFamily="Consolas" FontSize="12"/><TextBlock Text="Launch using" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Game store"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Ink}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="For a manually found installation, select your store. Epic requires its installation manifest for automatic launch." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Expander>
          </StackPanel></ScrollViewer></DockPanel>
    </Border>
  </Grid>
</Window>
