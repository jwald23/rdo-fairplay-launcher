<Window x:Class="CommunityFrontier.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1000" Height="760" MinWidth="740" MinHeight="520" Icon="Assets/rdo-fairplay-logo-clean.png" Background="#131313" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="124"/><RowDefinition Height="*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
    <Grid ClipToBounds="True">
      <Image Source="Assets/frontier-banner.png" Stretch="UniformToFill" VerticalAlignment="Center"/>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#CC131313" Offset="0"/><GradientStop Color="#35131313" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Grid Margin="24,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="HeaderLogo" Source="Assets/rdo-fairplay-logo-clean.png" Width="108" Height="108" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" AutomationProperties.Name="RDO FairPlay logo"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="RDO FairPlay" FontFamily="Bahnschrift Condensed" FontSize="32" FontWeight="Bold"/><TextBlock Text="A better place to ride." Foreground="#D5C9B9" FontSize="14" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="2" Content="Settings &amp; help" Command="{Binding ToggleSettingsCommand}" VerticalAlignment="Top" Margin="0" Background="#B3191919" Padding="14,9"/>
      </Grid>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="20,18,16,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <Grid MinHeight="460">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#1C1C1C" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="YOUR ACCOUNT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Margin="0,16,0,16">
            <TextBlock Text="{Binding RockstarStatus}" Foreground="{Binding RockstarColor}" FontWeight="SemiBold" FontSize="20" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding AccountSummary}" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" Margin="0,10,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DiscordIcon}" Foreground="{Binding DiscordColor}" Width="24"/><TextBlock Text="{Binding DiscordStatus}" FontSize="12"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding ServerIcon}" Foreground="{Binding ServerColor}" Width="24"/><TextBlock Text="{Binding ServerStatus}" FontSize="12"/></StackPanel>
            <TextBlock Text="{Binding AccountRefreshLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding KeyStatus}" FontSize="12" Margin="0,12,0,0" Foreground="{Binding KeyColor}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding KeyDetail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="3">
            <Button Content="{Binding PrimaryAccountLabel}" Command="{Binding PrimaryAccountCommand}" Margin="0,0,0,8" Padding="12,11" Background="{StaticResource Red}" BorderBrush="{StaticResource Red}"/>
            <UniformGrid Columns="2"><Button FontSize="11" Margin="0,0,4,0" Padding="7,9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Open Discord"/><Setter Property="Command" Value="{Binding JoinDiscordCommand}"/><Style.Triggers><DataTrigger Binding="{Binding DiscordConnected}" Value="True"><Setter Property="Content" Value="Sign out"/><Setter Property="Command" Value="{Binding DiscordCommand}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Refresh status" Command="{Binding RefreshAccountCommand}" FontSize="11" Margin="4,0,0,0" Padding="7,9"/></UniformGrid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR GAME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding GameStatus}" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Find game" Command="{Binding BrowseCommand}" Margin="12,0,0,0" Padding="12,8"/></Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
          <TextBlock Text="HOW DO YOU WANT TO PLAY?" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <RadioButton GroupName="Mode" IsChecked="{Binding FairPlaySelected}" IsEnabled="{Binding FairPlayAvailable}" AutomationProperties.Name="{Binding FairPlayAccessibleName}" Margin="0,0,0,10">
            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Fair Play" FontSize="19" FontWeight="SemiBold"/><Border Background="#332A25" CornerRadius="4" Padding="7,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding FairPlayBadge}" Foreground="#D4B288" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="Private lobbies for Verified members." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Mode" IsChecked="{Binding OriginalSettingsSelected}" AutomationProperties.Name="Original Settings — no verification needed">
            <StackPanel><TextBlock Text="Original Settings" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Play Red Dead Online with your original setup." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding ModeGuidance}" Foreground="#B8B0A4" FontSize="12" LineHeight="18" Margin="0,14,0,0"/>
      </Grid>
    </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#191919" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" MaxHeight="36" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
        <Button Grid.Column="1" Command="{Binding PlayCommand}" Content="{Binding PlayLabel}" Background="{StaticResource Red}" BorderBrush="{StaticResource Red}" FontSize="16" FontWeight="SemiBold" Padding="18,16" Margin="0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.RowSpan="2" Background="#191919" Margin="20,12,20,16" CornerRadius="10" Padding="20" Panel.ZIndex="2">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Settings &amp; help" FontSize="22" FontWeight="SemiBold"/><Button Content="Back to play" Command="{Binding ToggleSettingsCommand}" HorizontalAlignment="Right" Margin="0"/></Grid>
        <Border DockPanel.Dock="Top" Background="#24211D" Padding="12" CornerRadius="6" Margin="0,0,0,12" MaxHeight="130"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Status}" FontSize="13" AutomationProperties.LiveSetting="Polite"/></ScrollViewer></Border>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
          <StackPanel>
            <WrapPanel Margin="0,0,0,12"><TextBlock Text="{Binding VersionLabel}" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}"/><Button Content="Downloads &amp; updates ↗" Command="{Binding ReleasesCommand}"/></WrapPanel>
            
            <TextBlock Text="Discord activity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox IsChecked="{Binding DiscordActivityEnabled}" Foreground="{StaticResource Ink}" Cursor="Hand" VerticalContentAlignment="Center"><TextBlock Text="Show FairPlay on my Discord profile" Margin="6,0,0,0"/></CheckBox>
            <TextBlock Text="Shows the logo and links while the launcher is open. Requires the Discord desktop app and activity sharing enabled in Discord. Your account details and lobby key are never shown." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,20"/>
            <TextBlock Text="Game location" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding InstallationPrompt}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" IsEnabled="{Binding IsIdle}" MinHeight="34" AutomationProperties.Name="Game installation"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource Ink}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <WrapPanel Margin="0,10,0,0"><Button Content="Detect game" Command="{Binding DetectCommand}"/><Button Content="Choose RDR2.exe" Command="{Binding BrowseExeCommand}"/><Button Content="Choose folder" Command="{Binding BrowseCommand}"/></WrapPanel>
            <Expander Header="More ways to find your game" Foreground="{StaticResource Muted}" Margin="0,8,0,0"><StackPanel Margin="0,10,0,0">
              <TextBlock Text="Open your store to find Red Dead's installation folder, then choose it above." Margin="0,0,0,8"/>
              <WrapPanel><Button Content="Open Steam" Command="{Binding OpenSteamCommand}"/><Button Content="Open Epic Games" Command="{Binding OpenEpicCommand}"/><Button Content="Rockstar / I’m not sure" Command="{Binding HelpCommand}"/></WrapPanel>
              <WrapPanel><Button Content="Search my computer" Command="{Binding SearchCommand}"/><Button Content="Cancel search" Command="{Binding CancelCommand}"/></WrapPanel>
            </StackPanel></Expander>
            <TextBlock Text="Troubleshooting" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,6"/>
            <TextBlock Text="Run local checks or copy a report for Support. Reports include your game path." Foreground="{StaticResource Muted}"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="Check everything" Command="{Binding DiagnoseCommand}"/><Button Content="Copy diagnostic report" Command="{Binding CopyCommand}"/><Button Content="Open game folder" Command="{Binding OpenFolderCommand}"/></WrapPanel>
            <Expander Header="Diagnostic results" IsExpanded="{Binding DiagnosticsOpen}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding Diagnostics}" FontFamily="Consolas" FontSize="12"/><TextBlock Text="Launch using" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Game store"/><TextBlock Text="For a manually found installation, choose its store. Epic needs its installation manifest for automatic launch." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Expander>
            <Expander Header="Recovery &amp; uninstall" Foreground="{StaticResource Muted}" Margin="0,22,0,0"><StackPanel Margin="0,10,0,0">
              <TextBlock Text="Close Red Dead before restoring. Existing backups are kept." Margin="0,0,0,12"/>
              <TextBlock Text="Selected game: restore only the installation selected above to its pre-launcher configuration." Foreground="{StaticResource Muted}"/>
              <Button Content="Restore selected game" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,8,0,14"/>
              <TextBlock Text="All managed games: restore every installation FairPlay has changed on this PC." Foreground="{StaticResource Muted}"/>
              <Button Content="Restore all managed games" Command="{Binding EmergencyCommand}" HorizontalAlignment="Left" Margin="0,8,0,14"/>
              <TextBlock Text="Before removing the launcher: restore all managed games and keep recovery files." Foreground="{StaticResource Muted}"/>
              <Button Content="Prepare for uninstall" Command="{Binding UninstallCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel></Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
