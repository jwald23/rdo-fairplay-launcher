<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RDOFairPlay</AssemblyName>
    <Product>RDO FairPlay</Product>
    <Title>RDO FairPlay</Title>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/rdo-fairplay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CommunityFrontier.Core/CommunityFrontier.Core.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="DiscordRichPresence" Version="1.6.1.70" /></ItemGroup>
  <ItemGroup><None Update="launcher.settings.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/*.png" /><Resource Include="Assets/rdo-fairplay.ico" /></ItemGroup>
  <ItemGroup><None Include="../../docs/THIRD_PARTY_LICENSE.txt" Link="THIRD_PARTY_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
